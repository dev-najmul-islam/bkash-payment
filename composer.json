{
    "name": "najmul/bkash-payment",
    "description": "Laravel package for bKash payment integration",
    "type": "library",
    "license": "MIT",
    "authors": [
      {
        "name": "Najmul",
        "email": "devnajmulislam52@gmail.com"
      }
    ],
    "require": {
      "php": "^7.4|^8.0",
      "illuminate/support": "^8.0|^9.0|^10.0"
    },
    "autoload": {
      "psr-4": {
        "Najmul\\BkashPayment\\": "src/"
      },
      "classmap": [
        "resources"
      ]
    },
    "extra": {
      "laravel": {
        "providers": [
          "Najmul\\BkashPayment\\BkashServiceProvider"
        ]
      }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
  }
  